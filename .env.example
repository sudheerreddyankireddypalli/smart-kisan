# Smart Kisan (స్మార్ట్ కిసాన్) - Environment Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication Secret Key (Minimum 32 random characters recommended)
JWT_SECRET=smart_kisan_production_super_secret_jwt_key_2026_change_in_production

# Supabase Postgres Pooler Connection String (Session or Transaction pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# data.gov.in Mandi Price API Key (Obtain free from https://data.gov.in -> My Account)
DATA_GOV_KEY=your_data_gov_in_api_key_here
